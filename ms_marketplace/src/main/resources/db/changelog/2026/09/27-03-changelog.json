{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "20260927-03-dictionary-stats-user-index",
        "author": "claude (P4-05)",
        "comment": "Index on fk_user_id for the user.deleted cascade, which finds and deletes every row owned by a deleted user (matched on the event's keycloakId, the JWT subject stored here). Also serves a future 'my listings' query.",
        "changes": [
          {
            "createIndex": {
              "tableName": "dictionary_stats",
              "indexName": "idx_dictionary_stats_user",
              "columns": [
                {
                  "column": {
                    "name": "fk_user_id"
                  }
                }
              ]
            }
          }
        ],
        "rollback": [
          {
            "dropIndex": {
              "tableName": "dictionary_stats",
              "indexName": "idx_dictionary_stats_user"
            }
          }
        ]
      }
    }
  ]
}
