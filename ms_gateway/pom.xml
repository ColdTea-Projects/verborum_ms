<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>de.coldtea.verborum</groupId>
    <artifactId>msgateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ms_gateway</name>
    <description>ms_gateway</description>
    <properties>
        <java.version>17</java.version>
        <!-- Spring Cloud 2025.0.x ("Northfields") is the train for Spring Boot 3.5.x; 2025.1.x targets Boot 4.
             Pinned here, not in the aggregator, because only this module uses it (P5-01). -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- SEC-08: pinned above what Boot 3.5.16 manages, same values as the other services. Remove a pin
             once the Boot parent manages that version or newer. -->
        <tomcat.version>10.1.60</tomcat.version>                  <!-- 10.1.55: GHSA-9xv2-5v5q-p794 (CVSS 9.8) -->
        <jackson-bom.version>2.21.7</jackson-bom.version>         <!-- 2.21.4: GHSA-cxp5-3px4-pw24, GHSA-7hhh-6rmp-j9qf -->
        <commons-lang3.version>3.18.0</commons-lang3.version>     <!-- 3.17.0: GHSA-j288-q9x7-2f5v -->
        <log4j2.version>2.25.5</log4j2.version>                   <!-- 2.24.3: GHSA-qv9r-c865-cp47 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Gateway Server MVC: the servlet-stack gateway, so SecurityConfig, the body-limit filter and the
             test style are the ones the other services use -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- MockMvc JWT post-processors for the web-layer smoke tests -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Jacoco Plugin for Code Coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
