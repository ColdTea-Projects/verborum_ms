{
  "realm": "verborum",
  "enabled": true,
  "displayName": "Verborum",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "loginTheme": "verborum",
  "emailTheme": "verborum",
  "verifyEmail": true,
  "accessTokenLifespan": 300,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@verborum.app",
    "fromDisplayName": "Verborum",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 5184000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(8) and notEmail(undefined)",
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard Verborum user. Every registered account gets this."
      },
      {
        "name": "admin",
        "description": "Verborum administrator."
      }
    ]
  },
  "clients": [
    {
      "clientId": "verborum-app",
      "name": "Verborum app (Android, iOS, web)",
      "description": "Public client, Authorization Code + PKCE. Integration doc 6.1. Every Verborum client uses this one - the KMP web app authenticates as verborum-app too, redirecting to its own page rather than a custom scheme, which is why the separate verborum-web client was removed. Deployed origins are added to redirectUris by keycloak/bootstrap/configure.sh from APP_WEB_ORIGIN; only local values are committed here.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "de.coldtea.verborum://oauth2redirect/*",
        "http://localhost:*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "verborum-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "verborum-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "verborum-backend",
      "name": "Verborum backend (service-to-service)",
      "description": "Confidential client. Used by ms_user for Keycloak Admin API calls during registration.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "secret": "local-dev-only-change-me",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "verborum-dev-cli",
      "name": "LOCAL DEV ONLY - password grant for testing",
      "description": "Direct Access Grants so a developer can obtain a user token with curl. NOT part of the auth contract and MUST NOT exist in any shared or production realm - the real clients use Authorization Code + PKCE only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "verborum-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "verborum-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-verborum-backend",
      "enabled": true,
      "serviceAccountClientId": "verborum-backend",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    },
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@example.com",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testuser",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "testadmin",
      "enabled": true,
      "emailVerified": true,
      "email": "testadmin@example.com",
      "firstName": "Test",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "testadmin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ]
    }
  ]
}
