# Verborum — environment variables (TEMPLATE)
#
# Copy to `.env` (git-ignored) and fill in real values. Docker Compose reads `.env`
# automatically for ${VAR} interpolation, and the Spring services read the same names
# via `${VAR:default}` in their application.properties.
#
# LOCAL DEV NEEDS NONE OF THESE — every value below has a safe default baked into the
# code/compose for a developer laptop. Set them only to override for staging/prod, or to
# switch on features that need real credentials (Google/Facebook login, real SMTP).
#
# NEVER commit real secrets. This file holds placeholders only.

# ─── Databases ──────────────────────────────────────────────────────────────
DB_USER=coldtea
DB_PASSWORD=change-me
# Full JDBC URLs are per-service; override only when the DB host/name differs from local.
# DB_URL=jdbc:postgresql://db_dictionary:5432/vdbdictionary   # ms_dictionary
# DB_URL=jdbc:postgresql://db_user:5432/vdbprofile            # ms_user
# DB_URL=jdbc:postgresql://db_market:5432/vdbmarket           # ms_marketplace

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_USER=verborum
RABBITMQ_PASSWORD=change-me
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# ms_dictionary — when to publish dictionary.snapshot (marketplace reconciliation). Spring cron,
# 6 fields. Default nightly at 03:00; "0 * * * * *" = every minute, handy for local testing.
# DICTIONARY_SNAPSHOT_CRON=0 0 3 * * *
# ms_dictionary + ms_user — largest accepted request body in bytes (SEC-07); 413 above it. Default 2 MB.
# MAX_REQUEST_BODY_BYTES=2097152
# All three services — serve /v3/api-docs and /swagger-ui (SEC-12). true locally; set false in staging/prod.
# SWAGGER_ENABLED=true

# ─── Keycloak (identity server) ─────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Physical-device testing: all ports are loopback-only (SEC-02). Layer docker-compose.lan.yml, which
# exposes Keycloak alone and REQUIRES KEYCLOAK_ADMIN_PASSWORD (not "admin") and KEYCLOAK_HOSTNAME_URL.
# Issuer pinning — set all three to the SAME origin when testing on a physical device
# (a LAN IP), otherwise tokens are rejected with a 401. See docs/agent/security.md.
# KEYCLOAK_HOSTNAME_URL=http://localhost:8180
# KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/verborum
# KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/verborum/protocol/openid-connect/certs
# The audience every service requires in access tokens (SEC-05); keycloak-bootstrap adds it to the
# user-facing clients. Change it in one place only together with the realm.
# VERBORUM_JWT_AUDIENCE=verborum-api
# Offline sessions (offline_access) end after this many seconds in total — 180 days (SEC-06). Refresh
# tokens rotate regardless; this is the hard ceiling.
# OFFLINE_SESSION_MAX_LIFESPAN=15552000
# ms_user — account deletion needs a login no older than this many seconds (SEC-13).
# ACCOUNT_DELETION_MAX_LOGIN_AGE_SECONDS=300
# ms_user only — Keycloak Admin API (delete identities). Blank locally = skip with a WARN.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ─── SMTP (email verification + passwordless email-code) ────────────────────
# LOCAL: leave unset — Keycloak's realm points at the Mailpit container (host `mailpit`,
# port 1025, no auth). Open the Mailpit web UI at http://localhost:8025 to read the mail.
# STAGING/PROD: set these to a real provider (SES/SendGrid/Mailgun). The keycloak-bootstrap
# service overrides the realm's smtpServer with them via kcadm.sh (the realm JSON keeps the
# Mailpit defaults — native --import-realm can't substitute env vars; see security.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@verborum.app
SMTP_FROM_DISPLAY_NAME=Verborum
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_AUTH=true

# ─── Social sign-in (federated behind Keycloak) ─────────────────────────────
# Leave blank to keep the provider OFF. When set, the keycloak-bootstrap service creates
# the identity provider via kcadm.sh (never committed to the realm JSON — see security.md).
# Each environment needs its OWN OAuth app: the redirect URI is Keycloak's
#   {KEYCLOAK_HOSTNAME_URL}/realms/verborum/broker/{google|facebook}/endpoint
# and differs per environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
