# IntelliJ IDEA — per-machine IDE state
.idea/

# Maven build output
target/

# OS noise
.DS_Store
Thumbs.db

# Local secrets — real values live here, never committed. See .env.example for the shape.
.env
# Local-only Spring overrides (e.g. KEYCLOAK_ADMIN_CLIENT_SECRET)
application-local.properties

# Firebase / FCM service-account keys — a credential, never committed (docs/agent/push-notifications.md)
*firebase-adminsdk*.json
firebase-credentials*.json
service-account*.json

# Python bytecode (scripts/dev-seed)
__pycache__/
